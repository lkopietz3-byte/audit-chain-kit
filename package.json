{
  "name": "audit-chain-kit",
  "version": "0.1.0",
  "description": "Append-only, hash-chained audit log with a dependency-free verifier a skeptical third party can run themselves.",
  "keywords": [],
  "author": "Lucas Kopietz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lkopietz3-byte/audit-chain-kit.git"
  },
  "homepage": "https://github.com/lkopietz3-byte/audit-chain-kit#readme",
  "bugs": {
    "url": "https://github.com/lkopietz3-byte/audit-chain-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hash-node-fallback": {
      "types": "./dist/hash-node-fallback.d.ts",
      "import": "./dist/hash-node-fallback.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "audit:dependencies": "npm audit --package-lock-only --include=dev --ignore-scripts --audit-level=low",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
