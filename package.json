{
  "name": "audit-chain-kit",
  "version": "0.1.0",
  "description": "Append-only, hash-chained audit log with a dependency-free verifier a skeptical third party can run themselves.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hash-node-fallback": {
      "types": "./dist/hash-node-fallback.d.ts",
      "import": "./dist/hash-node-fallback.js"
    }
  },
  "files": [
    "dist",
    "reference-impl"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=19"
  }
}
